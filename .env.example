# ---------------------------------------------------------------------------
# SENTINEL - example environment. Copy to .env and fill in real values.
# .env is gitignored. Never commit real secrets, keys or connection strings.
# ---------------------------------------------------------------------------

# --- server ---
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API and open a socket.
# In production this must include the deployed frontend origin.
CORS_ORIGINS=http://localhost:5173

# MongoDB Atlas connection string. Leave empty to run the server with the
# in-memory simulation store, which is enough for local development and demos.
MONGODB_URI=

# --- frontend (Vite exposes only VITE_* to the client) ---
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
